{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.12.1",
    "engines": {
        "node": "^26.0",
        "pnpm": "^10.12"
    },
    "scripts": {
        "dev": "concurrently -k -p \"[{name}]\" -n \"LARAVEL,VITE\" -c \"cyan,magenta\" \"pnpm run dev:server\" \"pnpm run dev:vite\"",
        "dev:vite": "vite",
        "dev:server": "php85 artisan serve || php artisan serve",
        "build": "vite build",
        "types:check": "tsc --noEmit"
    },
    "dependencies": {
        "@inertiajs/svelte": "^3.9.1",
        "@laravel/passkeys": "^0.2.0",
        "@lucide/svelte": "^1.65.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/qrcode": "^1.5.6",
        "apexcharts": "^8.6.0",
        "axios": "^1.21.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "input-otp": "^1.5.0",
        "laravel-vite-plugin": "^3.2.0",
        "qrcode": "^1.5.4",
        "sonner": "^2.0.8",
        "svelte": "^5.57.3",
        "svelte-sonner": "^1.2.2",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.9.3",
        "vite": "^8.3.5"
    },
    "devDependencies": {
        "@laravel/vite-plugin-wayfinder": "^0.1.11",
        "@rolldown/plugin-babel": "^0.2.4",
        "@types/node": "^26.6.6",
        "concurrently": "^10.0.6",
        "svelte-check": "^4.7.7",
        "vite-plus": "^1.4.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.5",
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@rollup/rollup-win32-x64-msvc": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.3.3",
        "lightningcss-linux-x64-gnu": "^1.33.0",
        "lightningcss-win32-x64-msvc": "^1.33.0"
    }
}
