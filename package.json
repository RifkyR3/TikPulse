{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "concurrently -k -p \"[{name}]\" -n \"LARAVEL,VITE\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:vite\"",
        "dev:vite": "vite",
        "dev:server": "php85 artisan serve || php artisan serve",
        "build": "vite build",
        "types:check": "tsc --noEmit"
    },
    "dependencies": {
        "@inertiajs/svelte": "^3.9.1",
        "@laravel/passkeys": "^0.2.0",
        "@lucide/svelte": "^1.59.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/vite": "^4.1.11",
        "@types/qrcode": "^1.5.6",
        "axios": "^1.20.0",
        "chart.js": "^4.5.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "input-otp": "^1.4.2",
        "laravel-vite-plugin": "^3.0.0",
        "qrcode": "^1.5.4",
        "sonner": "^2.0.0",
        "svelte": "^5.57.2",
        "svelte-sonner": "^1.2.1",
        "tailwind-merge": "^3.0.1",
        "tailwindcss": "^4.0.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.7.2",
        "vite": "^8.0.0"
    },
    "devDependencies": {
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@rolldown/plugin-babel": "^0.2.3",
        "@types/node": "^22.13.5",
        "concurrently": "^10.0.6",
        "svelte-check": "^4.7.7",
        "vite-plus": "^0.3.3"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1",
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@rollup/rollup-win32-x64-msvc": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
    }
}
