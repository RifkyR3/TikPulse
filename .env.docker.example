APP_NAME=TikPulse
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_PORT=8000
DB_PORT=5432
REDIS_PORT=6379

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=tikpulse
DB_USERNAME=postgres
DB_PASSWORD=secret123

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Auto-provision dummy MikroTik in dev
MIKROTIK_AUTO_SETUP=true
MIKROTIK_HOST=mikrotik-dummy
MIKROTIK_PORT=8728
MIKROTIK_USER=admin
MIKROTIK_PASS=admin123

VITE_APP_NAME="${APP_NAME}"
